# CoreChain Unified Decentralized Launcher Configuration
CORECHAIN_PORT=80
CORECHAIN_DATA_DIR=data
CORECHAIN_PIC_DIR=Pic
CORECHAIN_BLOCKS_DIR=installed_blocks
CORECHAIN_PACKAGES_DIR=packages
CORECHAIN_BACKUPS_DIR=backups

# Legacy DB paths for automatic one-time migration (optional)
LEGACY_WEBCHAIN_DB=../WebChain/webchain.db
LEGACY_LEARNCHAIN_DB=../DApps/elearning.db

# Background Auto-Update (CoreChain & .Blz packages)
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_INTERVAL_MIN=30
UPDATE_MANIFEST_URL=

# Auth & Internal Bus Secret (auto-generated in data/.secret if empty)
CORECHAIN_AUTH_SECRET=
AUTO_OPEN_BROWSER=true
